---
/**
 * Sands of Time runner: a small rooftop runner under the hero title, seen
 * through an ornate window frame. Game logic lives in src/lib/runner.ts.
 *
 * Frame geometry (scripts/slice-game-art.mjs prints it): the frame image is
 * 991 x 647 with its opening at x 106-882 and y 98-559, and an arch rising
 * to y 45 in the middle of the top bar. The canvas fills the opening's width
 * and runs from the arch's apex down to the bottom bar, so the top bar
 * covers its top corners (the HUD starts below that: HUD_TOP in runner.ts)
 * and the sky shows through the arch. The frame is squashed 6% to make the
 * opening's height match the canvas's 8:5 shape. The percentages below are
 * all of the figure's width.
 */
import { getImage } from "astro:assets"
import frameLight from "@/assets/game/frame-light.webp"
import frameDark from "@/assets/game/frame-dark.webp"
import framePortraitLight from "@/assets/game/frame-portrait-light.webp"
import framePortraitDark from "@/assets/game/frame-portrait-dark.webp"

// Two cuts of the same frame art: the landscape original (991 x 610, opening
// 8:5) from the `sm` breakpoint up, and a portrait build of it (991 x 1110,
// the pillars extended by scripts/make-portrait-frame.mjs) on phones, where the canvas is a thumb-friendly 776:985. The top
// and bottom bars are identical in both, so the padding and margins that
// place the canvas in the opening are the same percentages of the width.
const frameClass =
  "pointer-events-none absolute inset-x-0 top-0 aspect-[991/1110] w-full select-none sm:aspect-[991/610]"
// The figure spans the main column: the full viewport on phones, at most
// the column's ~34rem beside the nav rail. Astro generates these widths so
// phones are not sent the 991 px original.
const frameWidths = [420, 640, 991]
const frameSizes = "(min-width: 768px) 34rem, (min-width: 640px) calc(100vw - 3rem), 100vw"
const cut = (src: ImageMetadata) =>
  getImage({ src, widths: frameWidths, format: "webp" })
const frames = {
  light: { landscape: await cut(frameLight), portrait: await cut(framePortraitLight) },
  dark: { landscape: await cut(frameDark), portrait: await cut(framePortraitDark) },
}
---

<!-- On phones the figure bleeds to the viewport edges and the canvas is a
     tall 776:985 inside the portrait frame; from `sm` up it is 8:5 inside
     the landscape one. The game reads its logical height from the rendered
     aspect ratio. -->
<figure class="-mx-6 flex flex-col gap-2 font-mono sm:mx-0" data-sands-runner>
  <div class="relative pt-[4.28%] pb-[8.38%]">
    <canvas
      class="ml-[10.7%] block aspect-[776/985] w-[78.3%] touch-none bg-card/30 select-none sm:aspect-[8/5]"
      width="400"
      height="500"
      tabindex="0"
      role="img"
      aria-label="Sands of Time runner mini-game. Press space or tap to jump over rooftop gaps and clutter; hold R or hold the dagger to rewind time, even mid-run."
      data-runner-canvas></canvas>
    <!-- <picture> picks the cut for the viewport, so only one is fetched.
         The light one is the home page's largest paint and loads eagerly at
         high priority. The dark one is display:none under the light theme;
         lazy loading keeps the browser from fetching it there, while in dark
         mode it sits in the viewport and loads right after layout. -->
    {
      (["light", "dark"] as const).map((theme) => (
        <picture class={theme === "light" ? "contents dark:hidden" : "hidden dark:contents"}>
          <source
            media="(min-width: 640px)"
            srcset={frames[theme].landscape.srcSet.attribute}
            sizes={frameSizes}
            width={frames[theme].landscape.attributes.width}
            height={frames[theme].landscape.attributes.height}
          />
          <img
            src={frames[theme].portrait.src}
            srcset={frames[theme].portrait.srcSet.attribute}
            sizes={frameSizes}
            width={frames[theme].portrait.attributes.width}
            height={frames[theme].portrait.attributes.height}
            alt=""
            aria-hidden="true"
            loading={theme === "light" ? "eager" : "lazy"}
            fetchpriority={theme === "light" ? "high" : "auto"}
            decoding="async"
            class={frameClass}
          />
        </picture>
      ))
    }
  </div>
  <figcaption class="px-6 text-xs text-muted-foreground sm:px-0">
    <span class="hidden sm:inline">
      space to jump. hold r to rewind time. the dagger runs dry.
    </span>
    <span class="sm:hidden">
      tap to jump. hold the dagger to rewind time. it runs dry.
    </span>
  </figcaption>
</figure>

<script>
  import { initSandsRunner } from "@/lib/runner"

  // Boots on every page load under the ClientRouter and tears down before
  // the page is swapped away (the canvas is not persisted).
  // Booting loads the sprite atlas and builds the level, which is a chunk
  // of main-thread work; it waits for an idle moment so the hero above it
  // paints first. The canvas keeps its tinted placeholder until then.
  let dispose: (() => void) | null = null
  let pending: number | null = null
  const idle =
    "requestIdleCallback" in window
      ? (cb: () => void) => window.requestIdleCallback(cb, { timeout: 1500 })
      : (cb: () => void) => window.setTimeout(cb, 200)
  const cancelIdle =
    "cancelIdleCallback" in window
      ? (id: number) => window.cancelIdleCallback(id)
      : (id: number) => window.clearTimeout(id)
  // ...and only once the canvas is within a screen of the viewport, so a
  // phone that never scrolls down to the game never pays for it at all.
  let watcher: IntersectionObserver | null = null
  document.addEventListener("astro:page-load", () => {
    const canvas = document.querySelector<HTMLCanvasElement>(
      "[data-runner-canvas]"
    )
    if (!canvas) return
    const boot = () => {
      pending = idle(() => {
        pending = null
        dispose = initSandsRunner(canvas)
      })
    }
    if (!("IntersectionObserver" in window)) return boot()
    watcher = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return
        watcher?.disconnect()
        watcher = null
        boot()
      },
      { rootMargin: "100% 0px" }
    )
    watcher.observe(canvas)
  })
  document.addEventListener("astro:before-swap", () => {
    watcher?.disconnect()
    watcher = null
    if (pending !== null) cancelIdle(pending)
    pending = null
    dispose?.()
    dispose = null
  })
</script>

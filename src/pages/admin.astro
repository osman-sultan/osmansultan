---
import Layout from "@/layouts/main.astro"
import { ResumeAdmin } from "@/components/resume-admin"
import { API_URL } from "@/lib/api"

// Not linked from anywhere, kept out of the sitemap (astro.config.mjs) and
// out of search results. That only keeps it out of the way: what protects
// it is the GitHub sign-in, enforced by the API (backend/).
---

<Layout title="Admin" description="Site admin." noindex>
  <section class="flex flex-col gap-6">
    <h1 class="font-heading text-3xl font-semibold tracking-tight">Admin</h1>
    <ResumeAdmin client:only="react" api={API_URL}>
      <p slot="fallback" class="text-muted-foreground">checking…</p>
    </ResumeAdmin>
  </section>
</Layout>
